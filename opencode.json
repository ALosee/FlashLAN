{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "pencil": {
      "command": [
        "/Applications/Pencil.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
        "--app",
        "desktop"
      ],
      "enabled": true,
      "type": "local"
    },
    "sbean": {
      "type": "local",
      "command": ["npx", "sbean@latest", "mcp"],
      "enabled": true
    }
  }
}
