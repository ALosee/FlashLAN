{
  "name": "flash-lan",
  "version": "0.3.0",
  "private": true,
  "description": "局域网快传 - FlashLAN",
  "type": "module",
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "build:android": "tauri android build --apk",
    "build:ios": "tauri ios build",
    "build:ios:app-store": "tauri ios build --export-method app-store-connect",
    "build:macos": "tauri build --bundles dmg",
    "build:windows": "tauri build --bundles nsis,msi",
    "check": "pnpm typecheck && pnpm lint:check && pnpm fmt:check",
    "dev": "vite",
    "dev:ios": "tauri ios dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "icon:macos": "node scripts/generate-macos-icon.mjs",
    "ios:init": "tauri ios init",
    "lint": "oxlint --fix && eslint --fix .",
    "lint:check": "oxlint && eslint .",
    "prepare": "simple-git-hooks",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@soybeanjs/cva": "^0.0.9",
    "@soybeanjs/headless": "^0.30.0",
    "@soybeanjs/hooks": "^0.3.0",
    "@soybeanjs/theme": "^0.30.0",
    "@soybeanjs/ui": "^0.30.0",
    "@soybeanjs/utils": "^0.1.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-barcode-scanner": "^2.4.5",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@vueuse/core": "^13.0.0",
    "pinia": "^3.0.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.41",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@soybeanjs/eslint-config-vue": "^0.1.1",
    "@soybeanjs/ui-uno": "^0.30.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.3.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.9.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "sharp": "^0.35.4",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.6.2",
    "unocss": "^66.7.2",
    "unplugin-vue-components": "^31.1.0",
    "vite": "^6.3.5",
    "vite-plus": "^0.2.8",
    "vue-tsc": "^2.2.8"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm typecheck && pnpm lint && pnpm fmt && git diff --exit-code",
    "pre-push": "pnpm typecheck && pnpm lint:check && pnpm fmt:check"
  },
  "productName": "FlashLAN"
}
